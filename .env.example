# Waitlist delivery — no database; each signup is a Resend contact in the
# Waitlist segment, or an email to WAITLIST_TO when the segment is unset.
#
# Create the key at https://resend.com/api-keys after verifying the sending
# domain (see README, "Resend"). Set these three in Vercel under
# Project → Settings → Environment Variables for Production and Preview.

# A full access key: a sending-only key cannot add contacts.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Resend → Audience → Segments → Waitlist: the segment's ID.
RESEND_WAITLIST_SEGMENT_ID=

# Where signups land.
WAITLIST_TO=hello@oriastudio.ai

# Must be on a domain verified in Resend. oriastudio.ai is the site's own
# domain, so verifying it here keeps the whole flow on Oria infrastructure.
WAITLIST_FROM=Oria Waitlist <waitlist@oriastudio.ai>
